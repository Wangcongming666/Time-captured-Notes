"B" [label="External Environment\n独立备份介质", width=3.000];
"U" -> "S" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="94" HEIGHT="22">浏览/创作/实践</TD></TR></TABLE>>, style="solid"];
"R" -> "S" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">内容治理</TD></TR></TABLE>>, style="solid"];
"A" -> "S" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="63" HEIGHT="22">权限/运营</TD></TR></TABLE>>, style="solid"];
"S" -> "B" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">加密备份</TD></TR></TABLE>>, style="solid"];
