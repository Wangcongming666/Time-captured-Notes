digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.42", ranksep="0.65", splines=polyline, fontname="Microsoft YaHei"];
node [shape=box, style="rounded,filled", fillcolor="#EDF4F7", color="#245268", fontname="Microsoft YaHei", fontsize=16, margin="0.18,0.12"];
edge [color="#50687C", fontname="Microsoft YaHei", fontsize=12, arrowsize=0.7];
"U" [label="User\n身份聚合", width=1.389];
"N" [label="Note\n内容聚合根", width=1.611];
"M" [label="Media / Topic\n有序图与话题", width=2.125];
"C" [label="Comment / Like\n互动事实", width=2.250];
"F" [label="Folder / Favorite\n私有归档", width=2.625];
"P" [label="Practice\n实践聚合根", width=1.611];
"R" [label="Review / Report\n治理聚合", width=2.375];
"NT" [label="Notification\n收件箱", width=2.000];
"FO" [label="Follow\n关注关系", width=1.389];
"U" -> "N" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="93" HEIGHT="22">1 : 0..* 创作</TD></TR></TABLE>>, style="solid"];
"N" -> "M" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="93" HEIGHT="22">1 : 1..* 引用</TD></TR></TABLE>>, style="solid"];
"N" -> "C" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="62" HEIGHT="22">1 : 0..*</TD></TR></TABLE>>, style="solid"];
"U" -> "F" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="62" HEIGHT="22">1 : 0..*</TD></TR></TABLE>>, style="solid"];
"F" -> "N" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="62" HEIGHT="22">0..* : 1</TD></TR></TABLE>>, style="solid"];
"U" -> "P" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="62" HEIGHT="22">1 : 0..*</TD></TR></TABLE>>, style="solid"];
"P" -> "N" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="62" HEIGHT="22">0..* : 1</TD></TR></TABLE>>, style="solid"];
"R" -> "N" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="68" HEIGHT="22">版本化目标</TD></TR></TABLE>>, style="solid"];
"R" -> "P" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="68" HEIGHT="22">版本化目标</TD></TR></TABLE>>, style="solid"];
"U" -> "NT" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="62" HEIGHT="22">1 : 0..*</TD></TR></TABLE>>, style="solid"];
"U" -> "FO" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="75" HEIGHT="22">关注/被关注</TD></TR></TABLE>>, style="solid"];
}