digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.42", ranksep="0.65", splines=polyline, fontname="Microsoft YaHei"];
node [shape=box, style="rounded,filled", fillcolor="#EDF4F7", color="#245268", fontname="Microsoft YaHei", fontsize=16, margin="0.18,0.12"];
edge [color="#50687C", fontname="Microsoft YaHei", fontsize=12, arrowsize=0.7];
"D" [label="DRAFT\n本人私有", width=1.389];
"P" [label="PENDING\n等待审核", width=1.389];
"ON" [label="PUBLISHED\n唯一公开状态", width=1.833];
"R" [label="REJECTED\n原因仅本人", width=1.611];
"O" [label="OFFLINE\n治理下架", width=1.389];
"DEL" [label="DELETED\n终结", width=1.375];
"D" -> "P" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">完整提交</TD></TR></TABLE>>, style="solid"];
"P" -> "ON" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">审核通过</TD></TR></TABLE>>, style="solid"];
"P" -> "R" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="32" HEIGHT="22">驳回</TD></TR></TABLE>>, style="solid"];
"P" -> "D" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">本人撤回</TD></TR></TABLE>>, style="solid"];
"ON" -> "P" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="80" HEIGHT="22">本人编辑重审</TD></TR></TABLE>>, style="solid"];
"ON" -> "O" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="68" HEIGHT="22">审核员下架</TD></TR></TABLE>>, style="solid"];
"R" -> "D" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">本人整改</TD></TR></TABLE>>, style="solid"];
"O" -> "D" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">本人整改</TD></TR></TABLE>>, style="solid"];
"D" -> "DEL" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">本人删除</TD></TR></TABLE>>, style="solid"];
"P" -> "DEL" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">本人删除</TD></TR></TABLE>>, style="solid"];
"ON" -> "DEL" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">本人删除</TD></TR></TABLE>>, style="solid"];
"R" -> "DEL" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">本人删除</TD></TR></TABLE>>, style="solid"];
"O" -> "DEL" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">本人删除</TD></TR></TABLE>>, style="solid"];
}