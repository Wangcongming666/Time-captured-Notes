digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.42", ranksep="0.65", splines=polyline, fontname="Microsoft YaHei"];
node [shape=box, style="rounded,filled", fillcolor="#EDF4F7", color="#245268", fontname="Microsoft YaHei", fontsize=16, margin="0.18,0.12"];
edge [color="#50687C", fontname="Microsoft YaHei", fontsize=12, arrowsize=0.7];
"B" [label="宿主浏览器\n127.0.0.1:8080", width=2.250];
"N" [label="edge网络\nNginx :80", width=1.625];
