"N" -> "A" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="35" HEIGHT="22">/api</TD></TR></TABLE>>, style="solid"];
"A" -> "DB" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="35" HEIGHT="22">JDBC</TD></TR></TABLE>>, style="solid"];
"A" -> "R" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="35" HEIGHT="22">RESP</TD></TR></TABLE>>, style="solid"];
"A" -> "MQ" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="35" HEIGHT="22">AMQP</TD></TR></TABLE>>, style="dashed"];
"A" -> "F" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="56" HEIGHT="22">私有文件</TD></TR></TABLE>>, style="solid"];
"P" -> "A" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="59" HEIGHT="22">管理HTTP</TD></TR></TABLE>>, style="solid"];
"DB" -> "BK" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="2"><TR><TD WIDTH="32" HEIGHT="22">备份</TD></TR></TABLE>>, style="solid"];
