"DB" [label="back internal\nmysql :3306", width=2.125];
"R" [label="back internal\nredis :6379", width=2.125];
"MQ" [label="back internal\nRabbit :5672", width=2.125];
"F" [label="媒体持久卷\n仅挂app", width=1.611];
"P" [label="monitor profile\nPrometheus/Grafana", width=2.750];
"BK" [label="宿主外接介质\n加密离线备份", width=1.833];
