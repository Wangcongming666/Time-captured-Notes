# Run python scripts/init-env.py; empty values are deliberately unusable.
DB_PASSWORD=
DB_ROOT_PASSWORD=
RABBIT_PASSWORD=
CURSOR_HMAC_KEY=
DEMO_PASSWORD=
# Optional production MinIO settings. Pre-create a private bucket; keep credentials local.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=shiguang-media

# Optional upload limits; increase the gateway and multipart limits together.
VIDEO_MAX_BYTES=104857600
VIDEO_MAX_SECONDS=300
UPLOAD_MAX_FILE_SIZE=100MB
UPLOAD_MAX_REQUEST_SIZE=101MB
NGINX_CLIENT_MAX_BODY_SIZE=101m
