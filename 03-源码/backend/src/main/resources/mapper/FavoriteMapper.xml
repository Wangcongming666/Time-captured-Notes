<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.shiguang.notes.mapper.FavoriteMapper">
  <delete id="collectionDeleteFolder">
    DELETE FROM t_favorite WHERE folder_id=#{id}
  </delete>
  <insert id="collectionFavorite">
    INSERT IGNORE INTO t_favorite(user_id,folder_id,note_id) VALUES(#{user},#{folder},#{note})
  </insert>
  <delete id="collectionFavorite2">
    DELETE FROM t_favorite WHERE folder_id=#{folder} AND note_id=#{note}
  </delete>
  <select id="collectionHasFavorite" resultType="java.lang.Long">
    SELECT COUNT(*) FROM t_favorite WHERE user_id=#{user} AND note_id=#{note}
  </select>
  <select id="collectionFavorites" resultType="java.util.LinkedHashMap">
    SELECT id,note_id FROM t_favorite WHERE folder_id=#{folder} AND id&lt;#{before} ORDER BY id DESC LIMIT #{size}
  </select>
</mapper>
