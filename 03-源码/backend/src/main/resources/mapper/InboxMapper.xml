<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.shiguang.notes.mapper.InboxMapper">
  <select id="inboxTransactionsConsume" resultType="java.lang.Long">
    SELECT COUNT(*) FROM t_inbox WHERE consumer=#{consumer} AND event_id=#{value1}
  </select>
  <insert id="inboxTransactionsConsume2">
    INSERT INTO t_inbox(consumer,event_id,processed_at) VALUES(#{consumer},#{value1},UTC_TIMESTAMP(3))
  </insert>
</mapper>
