<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.shiguang.notes.mapper.InterestMapper">
  <select id="discoveryPreferences" resultType="java.util.LinkedHashMap">
    SELECT topic_id,mode FROM t_interest WHERE user_id=#{user}
  </select>
  <delete id="discoveryPreferences2">
    DELETE FROM t_interest WHERE user_id=#{user}
  </delete>
  <insert id="discoveryInterest">
    INSERT INTO t_interest(user_id,topic_id,mode) VALUES(#{user},#{topic},#{mode})
  </insert>
  <delete id="discoveryReset">
    DELETE FROM t_interest WHERE user_id=#{user}
  </delete>
</mapper>
