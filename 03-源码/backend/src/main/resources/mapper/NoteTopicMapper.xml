<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.shiguang.notes.mapper.NoteTopicMapper">
  <select id="contentTopicIds" resultType="java.util.LinkedHashMap">
    SELECT topic_id FROM t_note_topic WHERE note_id=#{id} ORDER BY id
  </select>
  <delete id="contentTopics">
    DELETE FROM t_note_topic WHERE note_id=#{id}
  </delete>
  <insert id="contentTopics2">
    INSERT INTO t_note_topic(note_id,topic_id) VALUES(#{id},#{t})
  </insert>
</mapper>
