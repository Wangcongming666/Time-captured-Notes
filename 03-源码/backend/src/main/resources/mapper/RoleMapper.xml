<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.shiguang.notes.mapper.RoleMapper">
  <select id="identityRoles" resultType="java.util.LinkedHashMap">
    SELECT r.code FROM t_role r JOIN t_user_role ur ON ur.role_id=r.id WHERE ur.user_id=#{id}
  </select>
  <select id="identityLockAdministrators" resultType="java.util.LinkedHashMap">
    SELECT id FROM t_role WHERE code='ADMIN' FOR UPDATE
  </select>
</mapper>
