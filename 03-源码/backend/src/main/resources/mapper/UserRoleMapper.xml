<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.shiguang.notes.mapper.UserRoleMapper">
  <insert id="demoBootstrapRun">
    INSERT INTO t_user_role(user_id,role_id) SELECT #{id},id FROM t_role WHERE code=#{value1}
  </insert>
  <insert id="identityCreate">
    INSERT INTO t_user_role(user_id,role_id) VALUES(#{value0},1)
  </insert>
  <delete id="identityChangeRoles">
    DELETE FROM t_user_role WHERE user_id=#{id}
  </delete>
  <insert id="identityChangeRoles2">
    INSERT INTO t_user_role(user_id,role_id) SELECT #{id},id FROM t_role WHERE code=#{role}
  </insert>
</mapper>
