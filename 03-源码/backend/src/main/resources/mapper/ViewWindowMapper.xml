<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.shiguang.notes.mapper.ViewWindowMapper">
  <insert id="statisticsView">
    INSERT IGNORE INTO t_view_window(subject_hash,note_id,window_start) VALUES(#{subject},#{note},FROM_UNIXTIME(FLOOR(UNIX_TIMESTAMP(UTC_TIMESTAMP())/1800)*1800))
  </insert>
</mapper>
